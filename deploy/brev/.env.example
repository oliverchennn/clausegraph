# Copy to deploy/brev/.env on the GPU VM; never commit the populated file.
# Select a Nemotron NIM container and pinned version from its NVIDIA deployment
# instructions/support matrix. Hosted model IDs are NOT container image names.
NIM_IMAGE=
# Registry/model-download credential when the chosen image requires it.
# This is NOT authentication for the running NIM's inference endpoint.
NGC_API_KEY=
