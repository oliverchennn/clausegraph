# Local development: copy to .env. Never commit the populated file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./.data/clausegraph.db
LOCAL_STORAGE_PATH=.data/documents
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=10485760
PROVIDER_TIMEOUT_SECONDS=40
PROVIDER_RETRIES=2
WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=300

# Blank keys mean unavailable, not successful fixture-backed integration.
# Get the hosted key at https://build.nvidia.com (model page -> Get API Key).
# Full setup and Brev credit instructions: docs/NVIDIA_BREV.md.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
TEXT_PROVIDER=nvidia
# Optional Brev text inference. Keep nvidia until the private tunnel/model is ready.
# NVIDIA_API_KEY is never forwarded to Brev. Evidence/OCR stays hosted.
# Run API/worker on the same host/network namespace as the SSH tunnel (not Compose).
BREV_NIM_BASE_URL=http://127.0.0.1:18000/v1
# Copy the exact id returned by the NIM /v1/models endpoint; do not guess.
BREV_NIM_MODEL=
# NVIDIA-only default: same key, separate multimodal evidence-check/OCR model.
EVIDENCE_PROVIDER=nvidia
NVIDIA_EVIDENCE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EVIDENCE_REASONING_BUDGET=1024
# Optional opt-in: set EVIDENCE_PROVIDER=gemini and supply GEMINI_API_KEY.
# No automatic fallback or hidden paid provider calls.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=

# Production: use Tiger Data's PostgreSQL connection URL with sslmode=require.
# ENVIRONMENT=production requires PostgreSQL AND private Spaces.
SPACES_ENDPOINT=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# Compose always uses its own local PostgreSQL, independent of DATABASE_URL.
POSTGRES_PASSWORD=clausegraph-local-only
# Next.js same-origin proxy for non-container local development.
API_INTERNAL_URL=http://127.0.0.1:8000
